{
  "name": "ants-app",
  "version": "1.0.0",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:device-core": "tsc -p tsconfig.tests.json && node --test --test-reporter=spec build/tests/tests/device/DeviceCore.test.js",
    "test:device-factory": "tsc -p tsconfig.tests.json && node --test --test-reporter=spec build/tests/tests/device/DeviceFactory.test.js",
    "test:module-factory": "tsc -p tsconfig.tests.json && node --test --test-reporter=spec build/tests/tests/modules/ModuleFactory.test.js",
    "test:registry": "tsc -p tsconfig.tests.json && node --test --test-reporter=spec build/tests/tests/registry/DeviceRegistry.test.js",
    "test:workspace": "tsc -p tsconfig.tests.json && node --test --test-reporter=spec build/tests/tests/workspace/Workspace.test.js",
    "test:workspace-session": "tsc -p tsconfig.tests.json && node --test --test-reporter=spec build/tests/tests/workspace/WorkspaceSession.test.js",
    "test:workspace-connections": "tsc -p tsconfig.tests.json && node --test --test-reporter=spec build/tests/tests/workspace/WorkspaceConnections.test.js",
    "test:event-queue": "tsc -p tsconfig.tests.json && node --test --test-reporter=spec build/tests/tests/runtime/EventQueue.test.js",
    "test:event-dispatcher": "tsc -p tsconfig.tests.json && node --test --test-reporter=spec build/tests/tests/runtime/EventDispatcher.test.js",
    "test:simulation-engine": "tsc -p tsconfig.tests.json && node --test --test-reporter=spec build/tests/tests/runtime/SimulationEngine.test.js",
    "test:simulation-clock": "tsc -p tsconfig.tests.json && node --test --test-reporter=spec build/tests/tests/runtime/SimulationClock.test.js",
    "test:telemetry-runtime-flow": "tsc -p tsconfig.tests.json && node --test --test-reporter=spec build/tests/tests/runtime/RuntimeEventHandlers.test.js build/tests/tests/runtime/TelemetryRuntimeFlow.test.js",
    "test:gateway-packet-receive-flow": "tsc -p tsconfig.tests.json && node --test --test-reporter=spec build/tests/tests/runtime/GatewayPacketReceiveFlow.test.js",
    "test:types": "tsc -p tsconfig.type-tests.json",
    "start": "node scripts/electron-vite.cjs preview",
    "dev": "node scripts/electron-vite.cjs dev",
    "build": "npm run typecheck && node scripts/electron-vite.cjs build",
    "test:spatial": "tsc -p tsconfig.tests.json && node --test --test-reporter=spec build/tests/tests/spatial/SpatialGrid.test.js",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "node scripts/electron-vite.cjs build && electron-builder --mac",
    "build:linux": "node scripts/electron-vite.cjs build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
