{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["src/engine/**/*", "src/shared/**/*", "tests/**/*.ts"],
  "exclude": ["tests/types/**/*"],
  "compilerOptions": {
    "composite": false,
    "module": "CommonJS",
    "moduleResolution": "node",
    "rootDir": ".",
    "outDir": "build/tests",
    "noEmit": false,
    "types": ["node"]
  }
}
